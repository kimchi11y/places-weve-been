{
  "name": "places-weve-been",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-photo-privacy.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "seed": "npm run db:migrate && tsx scripts/seed.ts",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/react": "^7.1.1",
    "@libsql/client": "^0.18.0",
    "astro": "^7.4.2",
    "d3": "^7.9.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "exifr": "^7.1.3",
    "heic-to": "^1.6.6",
    "i18n-iso-countries": "^7.14.0",
    "jose": "^6.2.14",
    "marked": "^18.1.2",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0",
    "yaml": "^2.9.1"
  }
}
