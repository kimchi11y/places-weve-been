# Copy to .env and fill in. Keep .env to yourself: git ignores it.

# Who may use /admin: the logins Tailscale shows for them, separated by commas
EDITORS=you@example.com

# From the Tailscale admin console → Settings → Keys. Only needed the first time; you can clear it afterwards.
TS_AUTHKEY=

# The site's address becomes https://<this>.<your tailnet>.ts.net. It ends up in a public list of certificates.
TS_HOSTNAME=trips
