---
import StickerSprite from '../components/StickerSprite.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Our family travel atlas: the places we have been, the stories and the photos.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FDF2EA" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Caveat:wght@500;700&family=Fraunces:ital,opsz,wght,SOFT,WONK@1,9..144,500..700,100,1&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <StickerSprite />
    <slot />
  </body>
</html>
