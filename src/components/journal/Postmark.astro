---
import { fmtShort } from '../../lib/format';

interface Props {
  name: string;
  code: string;
  day: Date;
  id: string;
}
const { name, code, day, id } = Astro.props;
const unit = `${name.toUpperCase()} ✦ ${code} ✦ `;
const ring = unit.repeat(Math.max(1, Math.round(30 / unit.length)));
---

<svg class="pmark" viewBox="0 0 110 110" aria-hidden="true">
  <defs><path id={id} d="M55 55m-38 0a38 38 0 1 1 76 0a38 38 0 1 1-76 0" /></defs>
  <circle cx="55" cy="55" r="48" fill="none" stroke="currentColor" stroke-width="2.2" />
  <circle cx="55" cy="55" r="29" fill="none" stroke="currentColor" stroke-width="1.5" />
  <text font-weight="700" font-size="9.5" letter-spacing="1.5" fill="currentColor"><textPath href={`#${id}`} textLength="236">{ring}</textPath></text>
  <text x="55" y="53" text-anchor="middle" font-weight="800" font-size="12.5" fill="currentColor">{fmtShort.format(day).toUpperCase()}</text>
  <text x="55" y="67" text-anchor="middle" font-weight="600" font-size="11" fill="currentColor">{day.getUTCFullYear()}</text>
</svg>
